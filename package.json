{
  "name": "kannabi",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "concurrently -k -n api,web 'pnpm dev:api' 'pnpm dev:web'",
    "dev:api": "node --watch --import tsx --env-file-if-exists=.env server/index.ts",
    "dev:web": "react-router dev",
    "mcp": "node --env-file-if-exists=.env dist/server/mcp.js",
    "dev:mcp": "node --import tsx --env-file-if-exists=.env server/mcp.ts",
    "typecheck": "react-router typegen && tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "react-router build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "node --import tsx --test server/*.test.ts",
    "test:integration": "node scripts/test-identity.mjs",
    "admin:grant": "node --import tsx --env-file-if-exists=.env server/grant-admin.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "test:setup": "node --test scripts/setup-env.test.mjs",
    "demo:seed": "node --import tsx --env-file-if-exists=.env scripts/demo/cli.ts seed",
    "demo:reset": "node --import tsx --env-file-if-exists=.env scripts/demo/cli.ts reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@neo4j/cypher-builder": "3.3.0",
    "better-auth": "1.7.4",
    "hono": "^4.13.7",
    "neo4j-better-auth": "0.1.1",
    "neo4j-driver": "^6.2.0",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.3",
    "uuid": "^14.0.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@react-router/dev": "^7.18.3",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "concurrently": "^10.0.5",
    "smtp-server": "^3.19.13",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
